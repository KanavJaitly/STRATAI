# Copy this file to .env and fill in the values before running the pipeline.

DATABASE_URL=postgresql://username:password@localhost:5432/stratai
TBA_API_KEY=your_the_blue_alliance_api_key
# STATBOTICS_API_KEY is optional for public API access if you do not have a key.
# STATBOTICS_API_KEY=your_statbotics_api_key
ENV=development

# --- ML serving: the D18 configuration Phase 4 evaluated (docs/ml_models.md section 9) ---
# EPA source. d18_statbotics_primary is the default and the only evaluated configuration:
# Statbotics from a verified snapshot, STRATAI fallback for 2026iscmp only.
# EPA_SOURCE=d18_statbotics_primary
# STATBOTICS_SNAPSHOT_DIR=/path/to/statbotics_snapshot_20261001T220423Z
# STRATAI_EPA_CHAIN=/path/to/chain_e77d9444c57a7b50.json
# Model pins: version tag AND the artifact sha256 printed by
# python -m scripts.register_d18_production_models (also in .agent/production/d18_model_registration.json).
# ML_REGISTRY_DIR=/path/to/ml_registry
# ML_RANKING_MODEL_VERSION_TAG=d18
# ML_RANKING_MODEL_SHA256=<sha256>
# ML_WIN_PROB_MODEL_VERSION_TAG=d18
# ML_WIN_PROB_MODEL_SHA256=<sha256>
