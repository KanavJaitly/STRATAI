# Copy this file to .env and fill in the values before running the pipeline.

DATABASE_URL=postgresql://username:password@localhost:5432/stratai
TBA_API_KEY=your_the_blue_alliance_api_key
# STATBOTICS_API_KEY is optional for public API access if you do not have a key.
# STATBOTICS_API_KEY=your_statbotics_api_key
ENV=development

# --- ML serving: the D18 configuration Phase 4 evaluated (docs/ml_models.md section 9) ---
# EPA source. d18_statbotics_primary is the default and the only evaluated configuration:
# Statbotics from a verified snapshot, STRATAI fallback for 2026iscmp only.
# EPA_SOURCE=d18_statbotics_primary
# STATBOTICS_SNAPSHOT_DIR=/path/to/statbotics_snapshot_20261001T220423Z
# STRATAI_EPA_CHAIN=/path/to/chain_e77d9444c57a7b50.json
# Model pins: version tag AND the artifact sha256 printed by
# python -m scripts.register_d18_production_models (also in .agent/production/d18_model_registration.json).
# ML_REGISTRY_DIR=/path/to/ml_registry
# ML_RANKING_MODEL_VERSION_TAG=d18
# ML_RANKING_MODEL_SHA256=<sha256>
# ML_WIN_PROB_MODEL_VERSION_TAG=d18
# ML_WIN_PROB_MODEL_SHA256=<sha256>
# P6-M10 strategy model (P7-M5): both required together
# ML_STRATEGY_MODEL_VERSION_TAG=p6m10-v1
# ML_STRATEGY_MODEL_SHA256=<sha256>
# Playoff PX-1 model and PX-2 calibrator (P7-M6): all four required together; the pick list also needs the PX
# gate records to name these sha256s
# ML_PX1_VERSION_TAG=<tag>
# ML_PX1_SHA256=<sha256>
# ML_PX2_CALIBRATOR_PATH=/path/to/px2_calibrator.json
# ML_PX2_CALIBRATOR_SHA256=<sha256>

# --- Team accounts (docs/team_workspaces.md) ---
# Who may read the analytics routes: members (sign-in required) or open. Unset: members outside development.
ACCESS_POLICY=members
# The code base members type to sign up. A secret: choose your own and never commit it.
TEAM_JOIN_CODE=change-me-to-a-long-random-code
# The code that signs someone up as an administrator. Must differ from TEAM_JOIN_CODE; make it long and random.
# With neither code set, sign-up is closed.
TEAM_ADMIN_JOIN_CODE=change-me-to-a-different-long-random-code
# Optional: comma-separated emails that sign up as admin whichever code they use (any case).
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Outgoing email for password-reset codes. Without SMTP, "forgot password" cannot send a code.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=stratai@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=stratai@example.com
# In development only: write emails to this folder instead of sending them.
# DEV_OUTBOX_DIR=./dev_outbox
# The web app's address, mentioned in reset emails.
# PUBLIC_APP_URL=http://localhost:5173
# Reverse proxies in front of the API (hosted: Vercel then Render), so rate limits see the real client address.
# AUTH_TRUSTED_PROXY_HOPS=0
